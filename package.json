{
  "name": "aiplay-studio",
  "version": "0.1.0",
  "private": false,
  "description": "Local creative studio with optional native YuE2 GGUF music generation and MCP controls.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "start:music": "node scripts/start-music.mjs",
    "start:remote": "node scripts/start-remote.mjs",
    "worker:runpod": "node worker/runpod-worker.js",
    "test:remote": "node --test server/engine/remote_test.js server/engine/remote_ui_test.js server/engine/runpod-account_test.js",
    "start:cloud": "node scripts/start-cloud.mjs",
    "dev": "node --watch server/index.js",
    "test": "node scripts/trace_load.mjs && node scripts/test_timeline.mjs && node scripts/test_watchdog.mjs && node scripts/test_workflow.mjs && node scripts/test_apimode.mjs",
    "smoke": "node scripts/smoke_api.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "ag-psd": "31.0.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "three": "0.185.1",
    "ws": "^8.18.0"
  },
