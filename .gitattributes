# examples/ IS CHECKED BYTE FOR BYTE, SO GIT MUST NOT REWRITE IT.
#
# examples/manifest.json records the sha256 of every file beside it, and
# server/docs_test.js compares those hashes on every commit. This machine has
# `core.autocrlf=true` — the Windows default — which means a fresh clone would
# receive the .json and .txt files with CRLF endings, their hashes would no
# longer match the manifest, and the gate would fail on a checkout nobody had
# touched. A gate that fails on a clean tree is a gate people delete.
#
# `text=auto` still lets git detect and leave the .mp3/.mp4/.png alone;
# `eol=lf` pins the working-tree endings of the text ones to what was hashed.
examples/** text=auto eol=lf

# server/score/fixtures/ is the same story. yue2_result.json records the
# sha256 of yue2_score.abc, and server/score/store_test.js compares them on
# every commit; a CRLF checkout of the .abc fails that lane on a clean tree.
server/score/fixtures/** text=auto eol=lf

# Shell entry points run inside Linux containers (the RunPod worker bootstrap)
# and must not acquire Windows CRLF endings from a Windows checkout.
*.sh text eol=lf

# A GitHub "Download ZIP" has no .git, so the build could not say which commit it
# is and showed "S unknown". GitHub makes those zips with `git archive`, which
# fills in $Format:...$ placeholders in files marked export-subst. So the zip
# carries its own commit and date; server/version.js reads them. See VERSIONING.md.
server/version.archive.json export-subst
