#!/bin/sh
# The cheap checks that have each caught a shipped-would-have-been bug:
#   trace_load     a top-level throw silently kills ALL of app.js (2 catches)
#   test_timeline  the maths that places every frame
#   test_watchdog  the /queue parse that decides whether a stalled job is killed
#   test_workflow  the graphs ComfyUI is actually asked to render
# smoke_api and test_apimode need the server running, so they stay manual —
# a hook that fails whenever the app is closed is a hook people delete.
node scripts/trace_load.mjs || exit 1
node scripts/test_timeline.mjs || exit 1
node scripts/test_watchdog.mjs || exit 1
node scripts/test_workflow.mjs || exit 1
node server/vfx/templates_test.js || exit 1
node server/vfx/store_test.js || exit 1
node server/vfx/routes_test.js || exit 1
node server/mcp-vfx_test.js || exit 1
# The DAW's store maths (meter maps, bar-derived timeline, the dirty-region
# hashes), its route surface, and the daw_* declared-and-dropped guard.
node server/daw/store_test.js || exit 1
node server/daw/routes_test.js || exit 1
node server/mcp-daw_test.js || exit 1
# The same declared-and-dropped guard, over the main tool list — plus the
# structural checks for the routes the image panels lean on.
node server/mcp-image_test.js || exit 1
# The imagetools tests need a python with PIL/numpy/scipy — the ComfyUI venv
# has all three. Guarded on its presence for the same reason the server tests
# stay manual: a hook that fails on a machine without the rig gets deleted.
PY="${AIPLAY_RIG:-D:/AI/aiplay-studio-bench}/venv/Scripts/python.exe"
if [ -x "$PY" ]; then "$PY" server/imagetools_test.py || exit 1; fi
# imgselect decides where every other op lands, so a regression here is a
# regression in all 25 adjustments and all 75 effects at once.
if [ -x "$PY" ]; then "$PY" server/imgselect_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/imgstroke_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/imgtext_test.py || exit 1; fi
# imgdoc composites THROUGH engine.py rather than owning a copy of the blend
# maths, and its blend list is parsed straight out of store.js — so this suite
# is also the alarm for a compositor rename or a blend-mode added on one side.
if [ -x "$PY" ]; then "$PY" server/imgdoc_test.py || exit 1; fi
# Shapes, canvas and geometry. Almost every case is arithmetic - 800 pixels,
# pi*a*b, a stroke that measures its own width - so a rasteriser that drifts by
# a fraction of a pixel fails here rather than in someone's eye six weeks later.
if [ -x "$PY" ]; then "$PY" server/imgshape_test.py || exit 1; fi
# Paths and liquify. Same argument as imgshape: a pen tool has a closed-form
# answer for everything - w*L of ink, pi*r^2 of area, a 20px push that moves a
# dot 20px - so a rasteriser or a displacement field that drifts fails here
# rather than in someone's eye. It also pins the two invariants that hide: a
# frozen pixel is BIT-identical, and straight alpha survives the warp (it
# checks the wrong way round too, so the guard cannot quietly stop working).
if [ -x "$PY" ]; then "$PY" server/imgpath_test.py || exit 1; fi
# imgexport writes real files in seven formats and reads every one of them back,
# so it is the slowest suite here — around 17s, and it prints where that went
# per section. It earns it: the encoder bugs it covers (a silently 3-of-4-entry
# ICO, a "lossless" WebP that rewrites transparent pixels, EXIF surviving a
# strip) are all invisible until somebody opens the file somewhere else.
if [ -x "$PY" ]; then "$PY" server/imgexport_test.py || exit 1; fi
# imgphoto_test ends with a 4096x4096 timing pass over all eight photo tools —
# about ten seconds, and it is the only thing that would notice one of them
# turning into a minute.
if [ -x "$PY" ]; then "$PY" server/imgphoto_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/timelinemix_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/vfx/engine_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/vfx/effects_test.py || exit 1; fi
# Particles: the closed form against RK4, cross-process sha1 determinism,
# scrub independence, the birth-integral, the caps. The sweeps above prove the
# pixel contract; this suite proves the particle system is RIGHT.
if [ -x "$PY" ]; then "$PY" server/vfx/particles_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/vfx/expressions_test.py || exit 1; fi
# expressions_test proves the sandbox; this one proves it reaches the pixels.
# Both, because the sandbox passed 100% for as long as the engine ignored it.
if [ -x "$PY" ]; then "$PY" server/vfx/expressions_engine_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/vfx/shapes_test.py || exit 1; fi
# Lights. Same bargain as shapes: everything a light does has a closed form -
# Lambert, inverse square, h*tan(cone/2), and a shadow whose umbra is similar
# triangles - so the suite predicts whole fields and compares arrays. It also
# prints the 1080p cost of every light type on every run, which is the only
# thing that would notice shading a layer turning into a second.
if [ -x "$PY" ]; then "$PY" server/vfx/lights_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/vfx/integration_test.py || exit 1; fi
# Audio → notes. The floors are the AMT eval's measured results (F1 0.93/0.914/
# 0.80/0.88, 12/12 chords, 3/3 bends, 100% playable fingering) re-proven per
# commit against synthesised ground truth; the transcription sections skip by
# themselves when basic-pitch is not in the venv, the refusal path always runs.
if [ -x "$PY" ]; then "$PY" server/vfx/notes_test.py || exit 1; fi
# The DAW engine: synth determinism, the bit-exact region-seam proof, and the
# P0-4 loopback estimator (+-1 ms on synthetic offsets 3-250 ms).
if [ -x "$PY" ]; then "$PY" server/daw/engine_test.py || exit 1; fi
