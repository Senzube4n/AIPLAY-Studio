# samples are not installed, so it runs on a machine that never downloaded.
if [ -x "$PY" ]; then "$PY" server/daw/instruments_test.py || exit 1; fi
# The embed round trip, with INDEPENDENT readers: PNG chunks and JPEG segments
# walked by hand, audio read back through ffmpeg's demuxer. Proves the marker
# survives every metadata mode ("none" included) and the Tier-2 toggle strips
# only the record — the behavioural half of the Tier-1 pin above.
if [ -x "$PY" ]; then "$PY" server/provenance_embed_test.py || exit 1; fi
# THE WELCOME WINDOW's parity gate and its content gate. The first is the usual
# two-directional census plus a third direction this surface has to hold — every
# action reachable by an AGENT as well, because "MCP controllable so an agent can
