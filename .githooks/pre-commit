node server/music/yue_test.js || exit 1
node server/music/yue_fit_test.js || exit 1
# The runner's YuE2 branch through a fake door: card handover, landing under
# the library's prefix, stage mapping, cancel reaching the process, single
# filing. Added the night Create learned the second engine.
node server/jobs_yue_test.js || exit 1
node server/score/abc_test.js || exit 1
node server/score/store_test.js || exit 1
node server/score/sheet_test.js || exit 1
node server/score/routes_test.js || exit 1
node server/mcp-music-score_test.js || exit 1
node server/daw/mcp-production_test.js || exit 1
# production_export_test also DECODES both paths and compares FRAMES: the
# editor's region cache as the browser streams it, the bounce, and the same
# song rendered in one window. Its format checks pass a bounce whose samples
# are wrong; the sample checks are the ones a dropped look-ahead, a return
# missing from the sum or a mis-ordered concatenation actually trip. ~13 s
# (13.5 / 13.8 / 13.0 s over three runs; an earlier comment here said ~18 s,
# which no run reproduced).
node server/daw/production_export_test.js || exit 1
# THE ARRANGER: the big-room plan is deterministic, every note it writes is a
# legal position inside its clip, the musical rules hold (lead off the beat,
# sub on the rests, roll accelerating, a silent beat before each drop), and
# the plan runs through the REAL route dispatcher into a temp dir.
node server/daw/arrange_test.js || exit 1
node server/mv/ui_test.js || exit 1
# THE PLAN OBJECT: bit transparency (three fixtures round-trip byte-identical,
# stageOfDoc unmoved), nothing derivable stored, the estimate agreeing with
# resolveShot/renderSize/videoSizeFor on the same document, approval binding to
# arguments, the runner halting with the rest still approved, and the cost
# table citing files that are really in this repository.
node server/mv/plan_test.js || exit 1
# THE REFERENCE GATE, with no Blender anywhere near it — which is the state it
# has to hold in, judging a file somebody emailed. Every fixture is a PNG this
# suite writes by hand, including a Paeth-filtered one, so it runs in a fraction
# of a second on a machine that has never installed the toolkit. It pins the
# case that shipped (rename a contact sheet, delete its sidecar, and a six-panel
# grid imported as a character's face) and, just as hard, the asymmetry that
# keeps the gate from becoming a wall: a jpeg, a 16-bit PNG or a truncated file
# gets NO verdict and is never refused.
node server/mv/blender_test.js || exit 1
# BLOCKED SHOTS. The words half (532 generated shot plans checked for holes and
# pronoun agreement — a prompt is read by something trained on English), the
# closed-form proof that a reference frame lands at the blocked shot's real
# camera angle, and the rule that the previz clip is never called a reference
# or a control video. Its last section launches Blender when Blender is here,
# ~4s, and skips itself loudly when it is not: the toolkit is a SEPARATE
# repository across a licence boundary, so a move renamed over there is
# invisible to every other check in this tree.
node server/mv/previz_test.js || exit 1
# THE BLOCKOUT DOOR — the second way frames reach a control render. Naming a
# shot really resolves to a file in this project's assets, the same ffprobe gate
# runs on it, and every wrong way of asking (a clip name on the blockout door,
# DWPose on grey capsules, an unknown source) is answered with a sentence rather
# than with a render. Its own header says it must run HERE: the clips are forged
# with ffmpeg into a temp dir, so it needs no Blender and no server, and the clip
# half skips loudly when ffmpeg is absent. ~1s.
node server/mv/blockout_test.js || exit 1
# ONE SHOT: the resolution the renderer itself uses. Order and membership of the
# reference list (the <Picture N> numbering is only true if this array is the one
# that gets staged), the silent drop said out loud (a declared name with no sheet
# reaches the render as NOTHING and warned nowhere before), the prop that must
# NOT re-route a scene onto the engine that costs ten times as much, and the
# per-take evidence — including that a take from before this feature admits it
# has none rather than borrowing the row's current prompt.
node server/mv/shot_test.js || exit 1
# THE THINGS THE BOARDS DO NOT CARRY: the name-word scan over DECLARED assets
# (a board whose text names a prop it references nowhere), pinned against
# LOOSENING - a loose any-word match reads "the gold line slides lower" as
# naming Gold Scree, and a warning that cries on compliant projects is one
# people learn to scroll past. Plus the vehicle heuristic that survives beside
# it, with no board skipped and the one false alarm it cannot catch written
# down as a known limit rather than left to be rediscovered as a bug.
node server/mv/bible_test.js || exit 1
# ── THE SECOND DOOR: image to mesh, and mesh to rig (server/mesh) ──────────
# The FORMAT CONTRACT, asserted on containers this suite builds itself. The
# promise is not "a 3D file" but a GLB with a skin — glTF joints AND
# inverseBindMatrices, used by a mesh node — because a rigged mesh and an
# unrigged one have the same extension and nearly the same size, so "the rig
# worked" cannot be read off an exit code. Its interesting half is the four
# near-misses: no bind matrices, no joints, a skin nothing uses, a bind pose for
# a different skeleton. A checker that only proves the good case passes on all
# four. No GPU, no python, no venv.
node server/mesh/glb_test.js || exit 1
# THE SKIN CHECK ITSELF, which glb_test.js only uses. assertSkinned is the one
# function in this repo that decides whether a file people hand each other is a
# rigged character or a lump, and it answers by reading the BIN: joint indices
# that address real nodes, one common root in the hierarchy, weights that exist
# and are not all zero. Its whole value is the near-misses, so the suite is 76
# assertions of malformed-but-plausible containers it builds itself — a skin
# nothing uses, joints with no common root, an accessor that runs off the end of
# the buffer. It ran nowhere until now, which meant the Avatars screen's entire
# admission rule was unguarded. No GPU, no python, no venv.
node server/mesh/glb_skin_test.js || exit 1
# AND THE HALF THE SKIN CHECK CANNOT MAKE. Two GLBs were built that are
# identical in every structural respect a glTF reader can name — same skins[],
# same joints, same MAT4 inverseBindMatrices, same JOINTS_0/WEIGHTS_0, every
# weight row summing to one, the same size to the byte — where one deforms and
# the other does not. assertSkinned passes both and so does Khronos; a rigger
# that binds every vertex to the root produces the second, and the app used to
# file it as the row's rigFile. So this suite POSES the skeleton: linear blend
# skinning in closed form, measuring the change in distance between the mesh's
# own points, because a rigid motion preserves every one of them and "did any
# vertex move" passes the exact file this exists to catch. It also pins the
# admission rule itself — both rig verbs, read out of the source — so an edit
# that puts skin.ok back in front of rigFile fails here, and it prints the
# measured cost on a constructed 256-bone/200k-vertex rig because the check now
# runs inside the rig path. Sections 1-6 and 8 need no python, no venv, no GPU
# and nothing installed; section 7 asks Blender the same question through its
# own importer and SKIPS LOUDLY, naming the missing interpreter, when the rig
# venv is absent. A skip is UNRUN, never a pass.
node server/mesh/deform_test.js || exit 1
# EVERY REFUSAL BEFORE SPEND, driven. The one that pays for the file is VRAM:
# this runs on the SAME 16 GB card the music and video engine lives on, and the
# alternative to refusing is a CUDA out-of-memory forty seconds in that reads as
# a bug in this feature and is really "something else has the card". The gate
# takes its reading as an argument so both sides are provable anywhere, and a
# machine with NO readable card must not be refused — absent evidence is not
# evidence. Also: a contact sheet refused before a mesh of a grid gets built,
# and a rig refused on a crate before a skeleton is invented for one.
node server/mesh/runner_test.js || exit 1
# THE SEPARATE-INTERPRETER RULE AND THE PROCESS TREE. UniRig cannot share the
# mesher's python, so the runner dispatches it to a second executable — and a
# cancelled rig that leaves its children alive holds the 16 GB card against the
# music engine until somebody notices by hand. This pins both: the executable
# actually chosen, and the tree actually killed.
node server/mesh/unirig_runtime_test.js || exit 1
# THE AVATAR SHELF, END TO END WITHOUT A GPU: the binary skin admitted and the
# declared-but-weightless one rejected, remote and data: images refused before
# any resource is loaded, oversize and malformed files refused, ids that cannot
# escape the shelf, post-import tampering blocking inspect AND export, and the
# HTTP surface's cross-site, opaque-origin and DNS-rebinding refusals. It also
# pins the MCP verbs against the route they share, which is what keeps
# server/mcp-avatars.js honest now that it names its arguments one by one.
node server/mesh/avatar_test.js || exit 1
# THE EAR's loop machinery: the critique->edit mapping validated against the
# REAL MCP tool schemas and the rack catalog (a card that promises an edit the
# tool would refuse is worse than no card), routes that are distinct OUTCOMES
# rather than intensity variants, the A/B guard actually calling its undo, and
# ACTOR HONESTY at the decision seam - `choice` refuses an agent actor and
# `judge` refuses a user one, so no argument anyone can pass records an AI
# decision as a human one. Do not thin: this suite is the invariant.
node server/daw/ear_test.js || exit 1
# The same declared-and-dropped guard, over the main tool list — plus the
# structural checks for the routes the image panels lean on.
node server/mcp-image_test.js || exit 1
# The provenance ledger: chain integrity, ACTOR HONESTY (an MCP-driven action
# can never record as a human one — the invariant every dossier stands on),
# the origin fold, and the source pins that keep the Tier-1 AI marker
# unstrippable via any exposed option. Art-50 compliance layer; do not thin.
node server/provenance_test.js || exit 1
node server/wildcards_test.js || exit 1

echo "  -- did the picture come back with what was asked for --"
node server/review_test.js || exit 1
# The NOTICE file's model list is GENERATED from server/models.js. That section
# is how a licence travels with a fork, and the hand-kept version had already
# gone stale in the worst direction — it omitted Ideogram 4, the one entry whose
# output terms nobody has read. This fails the commit if the catalogue moved and
# the file did not; the fix is `node scripts/gen_notice.mjs`.
node scripts/gen_notice.mjs --check || exit 1
# The map cannot name a phantom: every backticked tool name pipeline_guide
# utters must exist in the live tool list, or the guide is the drift it
# exists to prevent.
node server/mcp-guide_test.js || exit 1
# The imagetools tests need a python with PIL/numpy/scipy — the ComfyUI venv
# has all three. Guarded on its presence for the same reason the server tests
# stay manual: a hook that fails on a machine without the rig gets deleted.
PY="${AIPLAY_RIG:-}/venv/Scripts/python.exe"   # set AIPLAY_RIG to your ComfyUI rig; unset skips these lanes
if [ -x "$PY" ]; then "$PY" server/imagetools_test.py || exit 1; fi
# THE UNIRIG ADAPTER, which is STDLIB-ONLY and so does not want the guard above.
# The imagetools suites need PIL/numpy/scipy and are rightly skipped where the
# rig is absent; this one needs nothing but an interpreter, and gating it on the
# rig would mean the adapter's 23 tests never run on the machine most likely to
# be editing it. So: the rig's python when it is here, whatever python is on
# PATH when it is not, and skipped only where there is neither — which is the
# same "a hook that fails on a machine without the rig gets deleted" rule, read
# in the direction that keeps a suite running rather than the one that stops it.
ADAPTER_PY="$PY"
# ⚠ EXECUTE the candidates, do not merely locate them. On Windows `python3`
# resolves — to the Store's App Execution Alias — so `command -v` succeeds and
# running it prints "Python was not found". Two commits died on that after
# thousands of green lines. Each candidate must print its own path to count.
[ -x "$ADAPTER_PY" ] || ADAPTER_PY="$(python3 -c "import sys;print(sys.executable)" 2>/dev/null || python -c "import sys;print(sys.executable)" 2>/dev/null)"
if [ -n "$ADAPTER_PY" ]; then "$ADAPTER_PY" server/mesh/unirig_adapter_test.py || exit 1; fi
# imgselect decides where every other op lands, so a regression here is a
# regression in all 25 adjustments and all 75 effects at once.
if [ -x "$PY" ]; then "$PY" server/imgselect_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/imgstroke_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/imgtext_test.py || exit 1; fi
# imgdoc composites THROUGH engine.py rather than owning a copy of the blend
# maths, and its blend list is parsed straight out of store.js — so this suite
# is also the alarm for a compositor rename or a blend-mode added on one side.
if [ -x "$PY" ]; then "$PY" server/imgdoc_test.py || exit 1; fi
# Shapes, canvas and geometry. Almost every case is arithmetic - 800 pixels,
# pi*a*b, a stroke that measures its own width - so a rasteriser that drifts by
# a fraction of a pixel fails here rather than in someone's eye six weeks later.
if [ -x "$PY" ]; then "$PY" server/imgshape_test.py || exit 1; fi
# Paths and liquify. Same argument as imgshape: a pen tool has a closed-form
# answer for everything - w*L of ink, pi*r^2 of area, a 20px push that moves a
# dot 20px - so a rasteriser or a displacement field that drifts fails here
# rather than in someone's eye. It also pins the two invariants that hide: a
# frozen pixel is BIT-identical, and straight alpha survives the warp (it
# checks the wrong way round too, so the guard cannot quietly stop working).
if [ -x "$PY" ]; then "$PY" server/imgpath_test.py || exit 1; fi
# imgexport writes real files in seven formats and reads every one of them back,
# so it is the slowest suite here — around 17s, and it prints where that went
# per section. It earns it: the encoder bugs it covers (a silently 3-of-4-entry
# ICO, a "lossless" WebP that rewrites transparent pixels, EXIF surviving a
# strip) are all invisible until somebody opens the file somewhere else.
if [ -x "$PY" ]; then "$PY" server/imgexport_test.py || exit 1; fi
# imgphoto_test ends with a 4096x4096 timing pass over all eight photo tools —
# about ten seconds, and it is the only thing that would notice one of them
# turning into a minute.
if [ -x "$PY" ]; then "$PY" server/imgphoto_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/timelinemix_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/vfx/engine_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/vfx/effects_test.py || exit 1; fi
# Particles: the closed form against RK4, cross-process sha1 determinism,
# scrub independence, the birth-integral, the caps. The sweeps above prove the
# pixel contract; this suite proves the particle system is RIGHT.
if [ -x "$PY" ]; then "$PY" server/vfx/particles_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/vfx/expressions_test.py || exit 1; fi
# expressions_test proves the sandbox; this one proves it reaches the pixels.
# Both, because the sandbox passed 100% for as long as the engine ignored it.
if [ -x "$PY" ]; then "$PY" server/vfx/expressions_engine_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/vfx/shapes_test.py || exit 1; fi
# Lights. Same bargain as shapes: everything a light does has a closed form -
# Lambert, inverse square, h*tan(cone/2), and a shadow whose umbra is similar
# triangles - so the suite predicts whole fields and compares arrays. It also
# prints the 1080p cost of every light type on every run, which is the only
# thing that would notice shading a layer turning into a second.
if [ -x "$PY" ]; then "$PY" server/vfx/lights_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/vfx/integration_test.py || exit 1; fi
# Audio → notes. The floors are the AMT eval's measured results (F1 0.93/0.914/
# 0.80/0.88, 12/12 chords, 3/3 bends, 100% playable fingering) re-proven per
# commit against synthesised ground truth; the transcription sections skip by
# themselves when basic-pitch is not in the venv, the refusal path always runs.
if [ -x "$PY" ]; then "$PY" server/vfx/notes_test.py || exit 1; fi
# The DAW engine: synth determinism, the bit-exact region-seam proof, and the
# P0-4 loopback estimator (+-1 ms on synthetic offsets 3-250 ms).
if [ -x "$PY" ]; then "$PY" server/daw/engine_test.py || exit 1; fi
# [DAWREC] The capture codecs and the engine's audio mixing: the FLAC round
# trip at the 24-bit floor, encode/decode scale inverses ACROSS files, the
# region-seam proof extended to file-backed clips, sample-exact clip
# placement and trim, and the click landing blips exactly where told.
if [ -x "$PY" ]; then "$PY" server/daw/capture_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/daw/stereo_import_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/daw/region_lookahead_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/daw/limiter_tail_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/daw/return_stems_test.py || exit 1; fi
# The DAW rack: per-device DSP proofs (bypass bit-exact, EQ FFT, crest,
# limiter true-peak ceiling, tempo-grid delay, sidechain duck, vfx-keyframe
# automation), the full-graph seam/determinism pin, BS.1770 metering against
# its own calibration constant, and the per-device CPU budget.
if [ -x "$PY" ]; then "$PY" server/daw/rack_test.py || exit 1; fi
# The MASTERING SUITE. Everything here is a claim a wrong device would still
# make: LP4+HP4 measured against the closed-form allpass, the band tree
# summing back, the M/S butterfly bit-exact on float32-sourced audio, a
# multiband band ducking ITS band and nothing else, the maximizer holding a
