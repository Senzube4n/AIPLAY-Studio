# app.js, so its syntax gets a line of its own.
node --check web/videolab.js || exit 1
node server/videolab/ui_test.js || exit 1
node server/videolab/catalog_test.js || exit 1
# And the store, which had to learn to heal: videolab.json is rewritten whole on
# every save, so one save from a process holding an empty list erased two real
# comparisons while five clips still carried their tags. The tags are the second
# copy and the group list is derivable from them; this pins that derivation
# against the five REAL tags, and that it is additive — a heal that overwrote a
# group would delete a verdict somebody typed.
node server/videolab/store_test.js || exit 1
