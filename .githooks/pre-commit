# insert, so a ceiling knob is not a file's ceiling) and prints the CPU table.
if [ -x "$PY" ]; then "$PY" server/daw/master_test.py || exit 1; fi
# THE EAR's objective critic, against SYNTHESISED GROUND TRUTH: a mix built so
# the pad masks the vocal in a known band over known bars, a track rendered
# exactly 6 dB down, a bounce with a known number of pinned samples, a
# mono-summed file whose side energy is exactly zero, pink noise on the pink
# reference. A critic that drifts fails here rather than in someone's ears.
# It also pins the honest absence of the aesthetic judge - no fabricated score.
if [ -x "$PY" ]; then "$PY" server/daw/ear_test.py || exit 1; fi
# The bounce keeps its bit depth through the tagging pass: PCM_24 in, PCM_24
# out, every sample byte-identical (tag_audio.py once re-encoded to s16).
if [ -x "$PY" ]; then "$PY" server/daw/tag_bounce_test.py || exit 1; fi
if [ -x "$PY" ]; then "$PY" server/daw/tag_wav_test.py || exit 1; fi
# The instrument stage: the stereo seam contract on every patch, the four
# generate-this-part refusals, the SFZ subset against the packs we ship, and
